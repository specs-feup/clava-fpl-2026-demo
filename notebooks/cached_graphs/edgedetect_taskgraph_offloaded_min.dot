digraph G {
	rankdir=TB;
	node [shape=box];
	"TSrc" [label="TSrc: <task_graph_source>", fillcolor=lightgray];
	"TSink" [label="TSink: <task_graph_sink>", fillcolor=lightgray];
	"TSrc" -> "TSink" [style=invis];
	subgraph "cluster_T0" {
	label = "T0: edge_detect";
	bgcolor = bisque;
	"T0_src" [shape=circle, label=""];
	"T0_target" [shape=diamond, label=""];
	"T0_src" -> "T0_target" [style=invis];
	"T0.0" [label="T0.0: rgbToGrayscale", style="filled,solid", fillcolor=lightpink];
	"T0.0" -> "T0_target" [style=invis];
	"T0.1" [label="T0.1: edge_detect_out0", style="filled,solid", fillcolor=lightpink];
	"T0.1" -> "T0_target" [style=invis];
	"T0.2" [label="T0.2: convolve2d_rep0", style="filled,solid", fillcolor="#77dd77", penwidth=3, color="darkgreen"];
	"T0.2" -> "T0_target" [style=invis];
	"T0.3" [label="T0.3: edge_detect_out1", style="filled,solid", fillcolor=lightpink];
	"T0.3" -> "T0_target" [style=invis];
	"T0.4" [label="T0.4: convolve2d_rep1", style="filled,solid", fillcolor=lightpink];
	"T0.4" -> "T0_target" [style=invis];
	"T0.5" [label="T0.5: edge_detect_out2", style="filled,solid", fillcolor=lightpink];
	"T0.5" -> "T0_target" [style=invis];
	"T0.6" [label="T0.6: convolve2d_rep2", style="filled,solid", fillcolor=lightpink];
	"T0.6" -> "T0_target" [style=invis];
	"T0.7" [label="T0.7: combthreshold", style="filled,solid", fillcolor=lightpink];
	"T0.7" -> "T0_target" [style=invis];
	}

	"T0_src" -> "T0.0" [label=""];
	"T0_src" -> "T0.0" [label=""];
	"T0_src" -> "T0.1" [label=""];
	"T0.0" -> "T0.2" [label="", color="black", fontcolor="black"];
	"T0.1" -> "T0.2" [label="", color="black", fontcolor="black"];
	"T0_src" -> "T0.2" [label=""];
	"T0.1" -> "T0.3" [label="", color="black", fontcolor="black"];
	"T0.2" -> "T0.4" [label="", color="black", fontcolor="black"];
	"T0.3" -> "T0.4" [label="", color="black", fontcolor="black"];
	"T0.0" -> "T0.4" [label="", color="black", fontcolor="black"];
	"T0.3" -> "T0.5" [label="", color="black", fontcolor="black"];
	"T0.2" -> "T0.6" [label="", color="black", fontcolor="black"];
	"T0.5" -> "T0.6" [label="", color="black", fontcolor="black"];
	"T0_src" -> "T0.6" [label=""];
	"T0.4" -> "T0.7" [label="", color="black", fontcolor="black"];
	"T0.6" -> "T0.7" [label="", color="black", fontcolor="black"];
	"T0.2" -> "T0.7" [label="", color="black", fontcolor="black"];
	"TSrc" -> "T0_src" [label="", color="black", fontcolor="black"];
	"TSrc" -> "T0_src" [label="", color="black", fontcolor="black"];
	"TSrc" -> "T0_src" [label="", color="black", fontcolor="black"];
	"TSrc" -> "T0_src" [label="", color="black", fontcolor="black"];
	"TSrc" -> "T0_src" [label="", color="black", fontcolor="black"];
	"T0_target" -> "TSink" [label="", color="black", fontcolor="black"];
	"T0_target" -> "TSink" [label="", color="black", fontcolor="black"];
	"T0_target" -> "TSink" [label="", color="black", fontcolor="black"];
	"T0_target" -> "TSink" [label="", color="black", fontcolor="black"];

}